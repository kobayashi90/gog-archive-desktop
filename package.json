{
  "name": "gog-archive",
  "productName": "GOG Archive Desktop",
  "description": "Desktop client for gog.squid.wtf — browse the catalog, download games via aria2/BitTorrent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Kobayashi",
    "email": "kobayashi90@users.noreply.github.com"
  },
  "packageManager": "pnpm@11.8.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "VITE_DEV=1 electron .",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "test": "node --test electron/",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4",
    "bittorrent-tracker": "11.2.3",
    "create-torrent": "6.1.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "svelte": "^5",
    "vite": "^5",
    "webtorrent": "3.0.21"
  },
  "build": {
    "appId": "io.github.gog-archive",
    "executableName": "gog-archive",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.test.mjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/aria2c",
        "to": "bin/aria2c"
      }
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "electron/icon.png",
      "category": "Game"
    },
    "deb": {
      "maintainer": "Kobayashi <kobayashi90@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.games"
    }
  }
}
